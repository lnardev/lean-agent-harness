{
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*/.ssh/*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*/.ssh/*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "rm -rf": "ask",
      "rm -rf *": "ask",
      "rm * -rf": "ask",
      "rm * -rf *": "ask",
      "rm -fr": "ask",
      "rm -fr *": "ask",
      "rm * -fr": "ask",
      "rm * -fr *": "ask",
      "rm -rF": "ask",
      "rm -rF *": "ask",
      "rm * -rF": "ask",
      "rm * -rF *": "ask",
      "rm -Rf": "ask",
      "rm -Rf *": "ask",
      "rm * -Rf": "ask",
      "rm * -Rf *": "ask",
      "rm -fR": "ask",
      "rm -fR *": "ask",
      "rm * -fR": "ask",
      "rm * -fR *": "ask",
      "rm -r": "ask",
      "rm -r *": "ask",
      "rm * -r": "ask",
      "rm * -r *": "ask",
      "rm -R": "ask",
      "rm -R *": "ask",
      "rm * -R": "ask",
      "rm * -R *": "ask",
      "rm --recursive": "ask",
      "rm --recursive *": "ask",
      "rm * --recursive": "ask",
      "rm * --recursive *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git reset * --hard": "ask",
      "git reset * --hard *": "ask",
      "git push --force": "ask",
      "git push --force *": "ask",
      "git push * --force": "ask",
      "git push * --force *": "ask",
      "git push -f": "ask",
      "git push -f *": "ask",
      "git push * -f": "ask",
      "git push * -f *": "ask",
      "sudo": "ask",
      "sudo *": "ask"
    }
  }
}
