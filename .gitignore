# Dependencias de Node
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Empaquetado de npm (archivos generados con npm pack)
*.tgz

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Artefactos generados al probar el CLI / script localmente
# (Evita commitear las carpetas que crea el instalador al probar npx o install.sh dentro del repo)
.claude/
.cursor/
.commandcode/
.pi/
.codex/
.opencode/

# Logs generales y temporales
*.log
.tmp/
tmp/
# Estado efímero de tareas (puede contener notas de sesión)
.tasks/
